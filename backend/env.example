# Copy this file to backend/.env (and fill in real values) — never commit the filled-in version.

# --- Database ---
DATABASE_URL=postgresql+asyncpg://manakai:manakai@localhost:5432/manakai

# --- Vector DB ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=bis_chunks

# --- Auth ---
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRY_MINUTES=60

# --- Embeddings ---
EMBEDDING_MODEL=BAAI/bge-m3

# --- Agentverse (optional — see docs/AGENTVERSE_INTEGRATION.md) ---
AGENTVERSE_API_KEY=

# --- App ---
ENV=development
LOG_LEVEL=info

# --- Retrieval thresholds (see docs/RETRIEVAL_LOGIC.md — tune after benchmark run) ---
RETRIEVAL_ABSTAIN_THRESHOLD=0.40
RETRIEVAL_HIGH_THRESHOLD=0.75
RETRIEVAL_MEDIUM_THRESHOLD=0.55
